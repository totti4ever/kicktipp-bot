# required environment variables
KICKTIPP_EMAIL=email@example.com
KICKTIPP_PASSWORD=Password123
KICKTIPP_NAME_OF_COMPETITION=competition-name

# optional environment variables
KICKTIPP_HOURS_UNTIL_GAME=8
KICKTIPP_RUN_EVERY_X_MINUTES=20
OVERWRITE_TIPS=false  # Optional: Overwrite already set tips (true/false, default: false)
ODDS_PROVIDER=kicktipp.de  # 'kicktipp.de' (default) or 'the-odds-api.com'
THE_ODDS_API_KEY=  # Only required if ODDS_PROVIDER='the-odds-api.com'
ODDS_STRATEGY=advanced # Optional: 'advanced' or 'simple' (default)

# allow tty
PYTHONUNBUFFERED=1

# CHROMEDRIVER_PATH=/usr/bin/chromedriver # uncomment this if you run without docker and encounter problems with the driver

ZAPIER_URL=https://hooks.zapier.com/hooks/catch/12345678/abcdefgh/

NTFY_URL=https://ntfy.your-domain.com/kicktipp-bot
NTFY_USERNAME=your-username
NTFY_PASSWORD=your-password

WEBHOOK_URL=https://your-home-assistant-url.com/api/webhook/your-webhook-id

SENTRY_DSN=https://token@org.ingest.de.sentry.io/project
SENTRY_ENVIRONMENT=localhost
TIPPS_PERSIST_TO=../data/tipp_history.json # Optional: Persistiere getätigte Tipps inkl. Quoten für Nachvollziehbarkeit
ODDS_CACHE_PERSIST_TO=../data/odds_cache.json # Optional: Persistiere Quoten, um beim Debugging API-Calls zu sparen
